<resources>
    <style name="NotifCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
    </style>
    <style name="NotifButton">
        <item name="android:layout_width">46dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">@drawable/n_button</item>
        <item name="android:scaleType">center</item>
    </style>
    <style name="NotifButtonSmall" parent="NotifButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:layout_gravity">center</item>
    </style>
    <style name="NotifOk">
        <item name="android:background">@drawable/n_button_ok</item>
        <item name="android:gravity">center</item>
        <item name="android:text">OK</item>
        <item name="android:textColor">#FFECECF1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
